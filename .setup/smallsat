#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
usage() {
    echo "Usage: bash .setup/smallsat {setup [options]|run COMMAND [args...]|shell|check [--mpc] [--gpu]}"
    echo "setup defaults to Linux/CUDA with MPC; pass --cpu or --without-mpc as needed."
}
command=${1:---help}
if (( $# )); then shift; fi
case "$command" in
    setup) exec bash "$repo_root/.setup/ubuntu/setup.sh" "$@" ;;
    run|shell|check)
        [[ -x "$repo_root/.venv/bin/python" ]] || { echo "Run setup first." >&2; exit 1; }
        cd "$repo_root"
        source .setup/env.sh
        case "$command" in
            run)
                (( $# )) || { usage >&2; exit 2; }
                exec uv run --no-sync "$@" ;;
            shell) exec uv run --no-sync bash --norc -i ;;
            check) exec uv run --no-sync python .setup/check_install.py "$@" ;;
        esac ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
